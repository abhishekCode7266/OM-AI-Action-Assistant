# ==============================================================================
# OM AI ASSISTANT — ENVIRONMENT CONFIGURATION
# Tagline: Think. Talk. See. Act. Achieve.
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_APP_NAME="OM AI Assistant"
NEXT_PUBLIC_APP_TAGLINE="Think. Talk. See. Act. Achieve."
PORT=3000

# ------------------------------------------------------------------------------
# 1. AI PROVIDERS (Server-side keys - Never exposed to frontend)
# Configure at least one provider to enable live AI responses.
# OM supports seamless switching between providers or graceful fallbacks.
# ------------------------------------------------------------------------------

# Google Gemini API (Recommended for Multimodal Vision & Speed)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API (For GPT-4o, GPT-4o-mini, DALL-E 3, Whisper)
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic Claude API (For Claude 3.5 Sonnet)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20240620"

# Groq API (Ultra-fast LLM inference)
# Get key at: https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"

# Local Ollama Provider (Optional local offline inference)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# ------------------------------------------------------------------------------
# 2. VOICE & SPEECH SERVICES
# Web Speech API is supported out-of-the-box in the browser.
# For premium synthesized voices or low-latency speech:
# ------------------------------------------------------------------------------

# ElevenLabs (Optional premium natural TTS)
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# ------------------------------------------------------------------------------
# 3. WEB SEARCH & RESEARCH PROVIDERS
# Configure for live web search and citations in Research mode.
# ------------------------------------------------------------------------------

# Tavily AI Search (Recommended for AI agents)
# Get key at: https://tavily.com/
TAVILY_API_KEY=""

# Serper Search (Google search API alternative)
# Get key at: https://serper.dev/
SERPER_API_KEY=""

# ------------------------------------------------------------------------------
# 4. CREATIVE WORKSPACES (Image & Video Generation)
# ------------------------------------------------------------------------------

# Replicate API (For Stable Diffusion XL, Flux, video generation)
# Get key at: https://replicate.com/
REPLICATE_API_TOKEN=""
